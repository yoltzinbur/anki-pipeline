    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Prepara la nota de Anki a partir de la página de Notion.\nconst DECK_NAME = 'German::Vocabulary';\nconst MODEL_NAME = 'Basic';\n\n// Anki no admite espacios en las etiquetas.\nconst toTag = (value) => String(value ?? '').trim().replace(/\\s+/g, '_');\nconst page = $json;\n\nreturn {\n  json: {\n    pageId: page.id,\n    status: page.property_anki_status,\n    ankiId: page.property_anki_id ?? null,\n    deckName: DECK_NAME,\n    modelName: MODEL_NAME,\n    fields: {\n      Front: page.property_term ?? '',\n      Back: page.property_translate ?? '',\n      Context: page.property_context ?? '',\n      Example: page.property_example ?? '',\n    },\n    tags: [\n      page.property_type && `German::Vocabulary::${toTag(page.property_type)}`,\n      page.property_level && `German::${toTag(page.property_level)}`,\n    ].filter(Boolean),\n  },\n};\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        672,
