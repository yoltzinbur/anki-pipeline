    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Prepara la nota de Anki a partir de la página de Notion.\nconst DECK_NAME = 'German::Grammar';\nconst MODEL_NAME = 'Cloze';\n\n// Anki no admite espacios en las etiquetas.\nconst toTag = (value) => String(value ?? '').trim().replace(/\\s+/g, '_');\nconst page = $json;\n\nreturn {\n  json: {\n    pageId: page.id,\n    status: page.property_anki_status,\n    ankiId: page.property_anki_id ?? null,\n    deckName: DECK_NAME,\n    modelName: MODEL_NAME,\n    fields: {\n      Topic: page.property_topic ?? '',\n      Text: page.property_cloze_text ?? '',\n      'Back Extra': page.property_extra ?? '',\n    },\n    tags: [\n      page.property_topic && `German::Grammar::${toTag(page.property_topic)}`,\n      page.property_level && `German::${toTag(page.property_level)}`,\n    ].filter(Boolean),\n  },\n};\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
