    {
      "parameters": {
        "jsCode": "// Ajusta la respuesta de la German Word API al formato de la base de Notion.\nconst { term } = $('Loop Over Words').first().json.normalizedData;\nconst item = $input.first();\nconst data = item.json.data;\n\n// Si la API devolvió otra forma (p. ej. \"Das Haus\" para \"Haus\"), se conservan ambas.\nif (data.word.toLowerCase() !== term.toLowerCase()) {\n  data.word = `${term} (API: ${data.word})`;\n}\n\n// Los campos de texto vacíos se envían como cadena vacía en lugar de null.\nfor (const key of ['translate', 'context', 'example']) {\n  data[key] = data[key] ?? '';\n}\n\nreturn [item];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2080,
        64
      ],
      "id": "0d714130-49ba-40ef-97cd-74f8921f8cf2",
      "name": "Format API Data"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 3
          },
          "conditions": [
            {
              "id": "934c3e66-1d7a-42e9-b9a8-a1bf991e848b",
              "leftValue": "={{ $json.error.status }}",
              "rightValue": 429,
              "operator": {
                "type": "number",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
