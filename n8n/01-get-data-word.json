    {
      "parameters": {
        "jsCode": "// Unifica la salida de ambos triggers en un mismo formato:\n// - \"On New Notion Page\" entrega las propiedades con su nombre original (Term, Type, NameFilter).\n// - \"Get Draft Pages\" las entrega simplificadas (property_term, property_type, ...).\nconst MIN_DELAY_SECONDS = 5;\nconst MAX_DELAY_SECONDS = 10;\n\n// Quita la anotación \"(API: ...)\" que \"Format API Data\" agrega cuando la API devuelve otra forma.\n// Así, volver a procesar una página no genera búsquedas como \"Hund)\".\nconst stripApiNote = (text) => text.replace(/\\s*\\(API:.*$/i, '').trim();\n\n// Deja solo caracteres válidos para una palabra: letras, espacios, guiones, apóstrofos y puntos.\nconst toQuery = (text) =>\n  stripApiNote(text).replace(/[^\\p{L}\\s'’.\\-]/gu, ' ').replace(/\\s+/g, ' ').trim();\n\nfor (const item of $input.all()) {\n  const page = item.json;\n  const isSimplified = 'property_term' in page || !('Term' in page);\n  const read = (simplifiedKey, originalKey) =>\n    String((isSimplified ? page[simplifiedKey] : page[originalKey]) ?? '').trim();\n\n  const term = stripApiNote(read('property_term', 'Term'));\n\n  page.normalizedData = {\n    term,\n    type: read('property_type', 'Type'),\n    // NameFilter es el término sin artículo (p. ej. \"Haus\" en lugar de \"das Haus\").\n    query: toQuery(read('property_name_filter', 'NameFilter')) || toQuery(term),\n    // Pausa aleatoria entre palabras para no saturar las fuentes.\n    delaySeconds:\n      Math.floor(Math.random() * (MAX_DELAY_SECONDS - MIN_DELAY_SECONDS + 1)) + MIN_DELAY_SECONDS,\n  };\n}\n\nreturn $input.all();\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        176
      ],
